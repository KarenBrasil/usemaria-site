generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price          Float
  oldPrice       Float?
  wholesalePrice Float?
  image          String?
  images         String[] @default([])
  isNew          Boolean  @default(false)
  isWholesale    Boolean  @default(false)
  isPromotion    Boolean  @default(false)
  isDraft        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sizes ProductSize[]

  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  size      String
  color     String   @default("Padrão")
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([productId, size, color])
}

model Customer {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  cpf   String?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     String @id @default(cuid())
  status String @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  total  Float

  // Endereço de Entrega
  zipcode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  shippingMethod    String?
  shippingCost      Float?
  shippingServiceId String?
  paymentMethod     String? @default("PIX")

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Float
  size     String
  color    String @default("Padrão")

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StoreSettings {
  id             String @id @default("default")
  storeName      String @default("USE MARIA")
  
  // Hero 1 (Banner Principal)
  hero1Image     String @default("/images/catalog/page-0001.jpg")
  hero1Subtitle  String @default("Nova Coleção")
  hero1Title     String @default("Vista Sua Fé")
  hero1Text      String @default("T-shirts femininas estampadas com delicadeza e propósito. Vista-se de amor e devoção todos os dias.")
  
  // Barra de Features
  feature1Title  String @default("Qualidade Premium")
  feature1Text   String @default("Algodão sustentável")
  feature2Title  String @default("Compre no Atacado")
  feature2Text   String @default("A partir de 10 peças")
  feature3Title  String @default("Design Exclusivo")
  feature3Text   String @default("Estampas católicas")
  feature4Title  String @default("Envio para todo Brasil")
  feature4Text   String @default("Rapidez e segurança")

  // Coleção (Seção de Produtos)
  collectionTitle    String @default("Nossas Estampas")
  collectionSubtitle String @default("Escolha a devoção que mais toca o seu coração.")

  // Editorial (Hero 2 - Banner Final)
  editorialTitle     String @default("Devoção em cada detalhe")
  editorialSubtitle  String @default("Acompanhe nosso trabalho no instagram")
  
  hero2Image     String @default("/images/catalog/page-0006.jpg")
  hero2Subtitle  String @default("Escolha da Estilista")
  hero2Title     String @default("O Look Perfeito")
  hero2Text      String @default("Capturado por @fotografo")
  
  // Contato & Redes Sociais
  whatsappNumber String @default("5585994277446")
  instagramUrl   String @default("#")
  tiktokUrl      String @default("#")
  
  // PIX Settings
  pixKey         String @default("CNPJ: 00.000.000/0001-00")
  pixName        String @default("USE MARIA OFICIAL")
}

model Reservation {
  id            String   @id @default(cuid())
  cartId        String   // ID gerado no navegador do usuário
  quantity      Int
  expiresAt     DateTime // 15 minutos no futuro
  createdAt     DateTime @default(now())

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
}
